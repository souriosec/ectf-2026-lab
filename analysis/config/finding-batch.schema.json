{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_id": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "reviewed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 8
          },
          "severity": {
            "enum": [
              "Critical",
              "High",
              "Medium",
              "Low",
              "Info"
            ]
          },
          "confidence": {
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "cwe": {
            "type": "integer",
            "minimum": 0
          },
          "subsystem": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "prerequisites": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          },
          "evidence_kind": {
            "enum": [
              "source-review",
              "tool-diagnostic"
            ]
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "line",
                "excerpt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "severity",
          "confidence",
          "cwe",
          "subsystem",
          "summary",
          "prerequisites",
          "impact",
          "remediation",
          "verification",
          "evidence_kind",
          "locations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "reviewer",
    "reviewed_files",
    "limitations",
    "findings"
  ],
  "additionalProperties": false
}
