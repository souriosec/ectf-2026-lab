{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CTF: Build firmware",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "${workspaceFolder}/.vscode/ctf.py",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CTF: Flash and start",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "${workspaceFolder}/.vscode/ctf.py",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CTF: List files",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "${workspaceFolder}/.vscode/ctf.py",
        "list"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CTF: Refresh clangd build commands",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "${workspaceFolder}/.vscode/ctf.py",
        "index"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CTF: Refresh editor configuration",
      "type": "process",
      "command": "/usr/bin/python3",
      "args": [
        "${workspaceFolder}/.vscode/ctf.py",
        "configure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
